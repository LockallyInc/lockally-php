{
    "name": "lockally/sdk",
    "version": "0.5.0",
    "description": "Official Lockally SDK for PHP: send email and manage mailboxes, domains and webhooks through the Lockally API.",
    "keywords": [
        "lockally",
        "email",
        "email-api",
        "transactional-email",
        "sdk",
        "php"
    ],
    "homepage": "https://lockally.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Lockally",
            "homepage": "https://lockally.com"
        }
    ],
    "support": {
        "issues": "https://github.com/LockallyInc/lockally-php/issues",
        "source": "https://github.com/LockallyInc/lockally-php",
        "docs": "https://developers.lockally.com"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "guzzlehttp/guzzle": "^7.3",
        "guzzlehttp/psr7": "^1.7 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0 || ^9.0",
        "friendsofphp/php-cs-fixer": "^3.5"
    },
    "autoload": {
        "psr-4": {
            "Lockally\\SDK\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lockally\\SDK\\Test\\": "test/"
        }
    }
}
